@page "/global-qr-management"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Quản lý QR Tổng — FoodTour Admin</PageTitle>

<style>
    .global-qr-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
    }
    .qr-card-large {
        padding: 40px;
        border-radius: 24px;
        border: 1px solid #F0E8E0;
        background: white;
        text-align: center;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 12px 40px rgba(232,103,42,0.08);
    }
    .qr-canvas-wrapper-large {
        background: white;
        padding: 24px;
        border-radius: 20px;
        border: 3px dashed #F4A574;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 24px 0;
    }
    .qr-url-box {
        background: #FBF7F2;
        padding: 12px 16px;
        border-radius: 12px;
        font-family: monospace;
        font-size: 0.9rem;
        color: #E8672A;
        word-break: break-all;
        margin-bottom: 24px;
        border: 1px solid #F4A574;
    }
    .action-buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
</style>

<MudStack Spacing="4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Style="font-weight: 800; color: #2D1F14;">📱 Quản lý QR Tổng Hệ Thống</MudText>
        <MudText Typo="Typo.body2" Style="color: #8C7B6B;">Mã QR này sẽ dẫn khách hàng đến danh sách toàn bộ các quán ăn trong hệ thống</MudText>
    </MudStack>

    <div class="global-qr-container">
        <MudPaper Class="qr-card-large" Elevation="0">
            <MudText Typo="Typo.h6" Style="font-weight: 700; color: #2D1F14;">FoodTour Global QR</MudText>
            
            <div class="qr-canvas-wrapper-large">
                <div id="global-qr" style="width: 300px; height: 300px; display: flex; align-items: center; justify-content: center;">
                    <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary" />
                </div>
            </div>

            <div class="qr-url-box">
                @_globalUrl
            </div>

            <div class="action-buttons">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Download"
                           Style="border-radius: 12px; text-transform: none; font-weight: 700; background-color: #E8672A;"
                           OnClick="DownloadQr">
                    Tải xuống
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           Style="border-radius: 12px; text-transform: none; font-weight: 700; border-color: #E8672A; color: #E8672A;"
                           OnClick="CopyLink">
                    Sao chép liên kết
                </MudButton>
            </div>
        </MudPaper>
    </div>
</MudStack>

@code {
    private string _globalUrl = "";
    private bool _qrGenerated = false;

    protected override void OnInitialized()
    {
        _globalUrl = $"{Navigation.BaseUri.TrimEnd('/')}/foodtour";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_qrGenerated)
        {
            _qrGenerated = true;
            await Task.Delay(200); // Wait for DOM
            await JS.InvokeVoidAsync("generateQrCode", "global-qr", _globalUrl, 300);
        }
    }

    private async Task DownloadQr()
    {
        try
        {
            await JS.InvokeVoidAsync("downloadQrCode", "global-qr", "FoodTour_Global_QR.png");
            Snackbar.Add("Đã tải xuống mã QR Tổng!", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Lỗi khi tải mã QR!", Severity.Error);
        }
    }

    private async Task CopyLink()
    {
        try
        {
            await JS.InvokeVoidAsync("copyToClipboard", _globalUrl);
            Snackbar.Add("Đã sao chép liên kết QR Tổng!", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Không thể sao chép!", Severity.Error);
        }
    }
}
