    private void LoadUiStrings(string langCode)
    {
        var filePath = Path.Combine(Env.WebRootPath, "locales", $"{langCode}.json");
        if (File.Exists(filePath))
        {
            var json = File.ReadAllText(filePath);
            _ui = JsonSerializer.Deserialize<Dictionary<string, string>>(json)
                  ?? new Dictionary<string, string>();
        }
        else
        {
            // Fallback sang tiếng Anh nếu file không tồn tại
            var fallback = Path.Combine(Env.WebRootPath, "locales", "en.json");
            if (File.Exists(fallback))
            {
                var json = File.ReadAllText(fallback);
                _ui = JsonSerializer.Deserialize<Dictionary<string, string>>(json)
                      ?? new Dictionary<string, string>();
            }
            else
            {
                _ui = new Dictionary<string, string>();
            }
        }
    }

