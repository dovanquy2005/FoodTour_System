@page "/"
@page "/dashboard"
@implements IDisposable
@using System.Threading
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ILogger<Dashboard> Logger
@inject FoodTour_WebAdmin.Api.Services.IDataUpdateNotifier DataUpdateNotifier
@using ApexCharts

<PageTitle>Dashboard — FoodTour Admin</PageTitle>

<MudStack Spacing="6">
    <!-- ═══════ PAGE HEADER ═══════ -->
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5" Style="font-weight: 800; color: #2D1F14;">
                🍜 Dashboard
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #8C7B6B;">
                Tổng quan hệ thống — Phố ẩm thực Vĩnh Khánh
            </MudText>
        </MudStack>
        <MudChip T="string" Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Size="MudBlazor.Size.Small"
                 Icon="@Icons.Material.Filled.CalendarToday">
            @DateTime.UtcNow.ToVietnamTime().ToString("dd/MM/yyyy")
        </MudChip>
    </MudStack>

    <!-- ═══════ STAT CARDS ═══════ -->
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="stat-card" Elevation="0"
                      Style="padding: 24px; border-radius: 16px; border: 1px solid #F0E8E0; background: linear-gradient(135deg, #FFFFFF, #FFF8F2);">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudAvatar Size="MudBlazor.Size.Medium"
                                   Style="background: linear-gradient(135deg, #E8672A, #F4A574);">
                            <MudIcon Icon="@Icons.Material.Filled.Storefront" Style="color: white;" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.h4" Style="font-weight: 800; color: #2D1F14;">@_totalShops</MudText>
                    <MudText Typo="Typo.body2" Style="color: #8C7B6B;">Tổng quán ăn</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>


        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="stat-card" Elevation="0"
                      Style="padding: 24px; border-radius: 16px; border: 1px solid #F0E8E0; background: linear-gradient(135deg, #FFFFFF, #F0FFF4);">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudAvatar Size="MudBlazor.Size.Medium"
                                   Style="background: linear-gradient(135deg, #5DAA68, #7BC87F);">
                            <MudIcon Icon="@Icons.Material.Filled.People" Style="color: white;" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.h4" Style="font-weight: 800; color: #2D1F14;">@_visitsLast24h</MudText>
                    <MudText Typo="Typo.body2" Style="color: #8C7B6B;">Lượt truy cập 24h qua</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="stat-card" Elevation="0"
                      Style="padding: 24px; border-radius: 16px; border: 1px solid #F0E8E0; background: linear-gradient(135deg, #FFFFFF, #FFFBF0);">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudAvatar Size="MudBlazor.Size.Medium"
                                   Style="background: linear-gradient(135deg, #3B82F6, #60A5FA);">
                            <MudIcon Icon="@Icons.Material.Filled.Devices" Style="color: white;" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.h4" Style="font-weight: 800; color: #2D1F14;">@_onlineDevices</MudText>
                    <MudText Typo="Typo.body2" Style="color: #8C7B6B;">Thiết bị đang online</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- ═══════ CHARTS ROW ═══════ -->
    <MudGrid Spacing="4">
        <MudItem xs="12" md="12">
            <MudPaper Elevation="0" Style="padding: 24px; border-radius: 16px; border: 1px solid #F0E8E0;">
                <MudStack Spacing="3">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color:#2D1F14;">
                            🔥 Hoạt động thiết bị (@(_viewMode == "Week" ? "Ngày trong tuần" : "Tháng trong năm"))
                        </MudText>
                        <MudToggleGroup T="string" Value="@_viewMode" ValueChanged="OnViewModeChanged"
                                        Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Primary" Variant="Variant.Outlined">
                            <MudToggleItem Value="@("Week")">Theo Tuần</MudToggleItem>
                            <MudToggleItem Value="@("Month")">Theo Năm</MudToggleItem>
                        </MudToggleGroup>
                    </MudStack>

                    <div style="margin-top: 10px;">
                        @if (_heatmapData != null && _heatmapData.Any())
                        {
                            <ApexChart @key="_viewMode" TItem="HeatmapDataPoint" Height="380" Options="_heatmapOptions">
                                @if (_viewMode == "Week")
                                {
                                    @foreach (var day in DayNames)
                                    {
                                        <ApexPointSeries TItem="HeatmapDataPoint"
                                                         Items="@(_heatmapData.Where(d => d.LabelY == day).OrderBy(d => d.ValueX).ToList())"
                                                         Name="@day" SeriesType="SeriesType.Heatmap" XValue="@(e => e.ValueX.ToString())"
                                                         YValue="@(e => (decimal)e.Count)" />
                                    }
                                }
                                else
                                {
                                    @foreach (var month in MonthNames)
                                    {
                                        <ApexPointSeries TItem="HeatmapDataPoint"
                                                         Items="@(_heatmapData.Where(d => d.LabelY == month).OrderBy(d => d.ValueX).ToList())"
                                                         Name="@month" SeriesType="SeriesType.Heatmap" XValue="@(e => "T" + e.ValueX)"
                                                         YValue="@(e => (decimal)e.Count)" />
                                    }
                                }
                            </ApexChart>
                        }
                        else
                        {
                            @* Hiển thị Loading mượt mà trong khi chờ dữ liệu nạp song song từ Task.WhenAll *@
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center"
                                      Style="height:380px; background: #fafafa; border-radius: 8px;">
                                <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true"
                                                     Size="MudBlazor.Size.Medium" />
                                <MudText Typo="Typo.caption" Class="mt-2">Đang tải dữ liệu hoạt động...</MudText>
                            </MudStack>
                        }
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- ═══════ RECENT SHOPS TABLE ═══════ -->
    <MudPaper Elevation="0" Style="padding: 24px; border-radius: 16px; border: 1px solid #F0E8E0;">
        <MudStack Spacing="3">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6" Style="font-weight: 700;">🍽️ Quán ăn gần đây</MudText>
                <MudButton Href="/shops" Variant="Variant.Text" Color="MudBlazor.Color.Primary"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Xem tất cả
                </MudButton>
            </MudStack>

            <MudTable Items="_recentShops" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm"
                      Style="border-radius: 12px; overflow: hidden;">
                <HeaderContent>
                    <MudTh Style="font-weight: 700;">Tên quán</MudTh>
                    <MudTh Style="font-weight: 700;">Địa chỉ</MudTh>
                    <MudTh Style="font-weight: 700;">Đánh giá</MudTh>
                    <MudTh Style="font-weight: 700; text-align: right;">Trạng thái</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Size="MudBlazor.Size.Small" Style="background: #FFF0E6; color: #E8672A;">
                                <MudIcon Icon="@Icons.Material.Filled.Store" Size="MudBlazor.Size.Small" />
                            </MudAvatar>
                            <MudText Style="font-weight: 600;">@context.Name</MudText>
                        </MudStack>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2" Style="color: #8C7B6B;">@context.Address</MudText>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="MudBlazor.Size.Small"
                                 Style="background: #FFF0E6; color: #E8672A; font-weight: 600;">
                            ★ @context.Rating.ToString("0.0")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Success"
                                 Variant="Variant.Filled">Hoạt động
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private int _totalShops;
    private int _visitsLast24h;
    private int _onlineDevices;
    private List<ShopModel>? _recentShops;
 
    // ── Heatmap Data ──────────────────────────────────────────────────────────
    private string _viewMode = "Week";
    private static readonly string[] DayNames = { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
    private static readonly string[] MonthNames = { "Th1", "Th2", "Th3", "Th4", "Th5", "Th6", "Th7", "Th8", "Th9", "Th10",
"Th11", "Th12" };
    
    private List<HeatmapDataPoint> _heatmapData = new();

    private ApexChartOptions<HeatmapDataPoint> _heatmapOptions = new()
    {
        PlotOptions = new PlotOptions
        {
            Heatmap = new PlotOptionsHeatmap
            {
                Distributed = true,
                Radius = 4,
                EnableShades = true,
                ShadeIntensity = 0.5,
                ColorScale = new PlotOptionsHeatmapColorScale
                {
                    Ranges = new List<PlotOptionsHeatmapColorScaleRange>
                    {
                        // Giữ nguyên màu xám cho giá trị bằng 0
                        new() { From = 0, To = 0, Name = "Không có", Color = "#F3F4F6" },

                        // Các tông đỏ (Red) từ nhạt đến đậm dần
                        new() { From = 1, To = 5, Name = "Thấp", Color = "#FCA5A5" }, // Red 300
                        new() { From = 6, To = 15, Name = "Trung bình", Color = "#EF4444" }, // Red 500
                        new() { From = 16, To = 30, Name = "Cao", Color = "#991B1B" }, // Red 800
                        new() { From = 31, To = 9999, Name = "Rất cao", Color = "#7F1D1D" } // Red 900
                    }
                }
            }
        },
        States = new States
        {
            Hover = new StatesHover { Filter = new StatesFilter { Type = (StatesFilterType)0 } },
            Active = new StatesActive
            {
                AllowMultipleDataPointsSelection = false,
                Filter = new StatesFilter
                {
                    Type = (StatesFilterType)0
                }
            }
        },
        Legend = new Legend { Show = true, Position = LegendPosition.Bottom },
        DataLabels = new DataLabels { Enabled = false }
    };

    // Class tổng quát dùng chung cho cả 2 chế độ
    private class HeatmapDataPoint
    {
        public string LabelY { get; set; } = string.Empty; // Chứa tên Ngày (CN, T2...) hoặc tên Tháng (Th1, Th2...)
        public int ValueX { get; set; } // Chứa Giờ (0-23) hoặc Tuần trong tháng (1-4)
        public int Count { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Khởi tạo các Task. Mỗi Task sử dụng một DbContext riêng biệt từ Factory.
        var totalShopsTask = Task.Run(async () =>
        {
            using var db = await DbFactory.CreateDbContextAsync();
            return await db.Shops.CountAsync();
        });

        var visitsTask = Task.Run(async () =>
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var cutoff = DateTime.UtcNow.AddHours(-24);
            return await db.TrialLogs.CountAsync(t => t.CreatedAt >= cutoff);
        });

        var recentShopsTask = Task.Run(async () =>
        {
            using var db = await DbFactory.CreateDbContextAsync();
            return await db.Shops
                .Include(s => s.ShopTranslations)
                .OrderByDescending(s => s.CreatedAt)
                .Take(5)
                .ToListAsync();
        });

        var onlineDevicesTask = Task.Run(async () =>
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var cutoff = DateTime.UtcNow.AddMinutes(-15);
            return await db.UserDevices.CountAsync(d => d.LastActive >= cutoff);
        });

        var heatmapTask = LoadHeatmapData();

        DataUpdateNotifier.OnDeviceUpdated += OnDeviceUpdatedHandler;
        // Chờ tất cả các tác vụ hoàn thành đồng thời mà không xung đột
        await Task.WhenAll(totalShopsTask, recentShopsTask, onlineDevicesTask, heatmapTask, visitsTask);

        // Gán kết quả sau khi tất cả đã xong
        _totalShops = await totalShopsTask;
        _visitsLast24h = await visitsTask;
        _recentShops = await recentShopsTask;
        _onlineDevices = await onlineDevicesTask;
    }

    // Gọi bởi IDataUpdateNotifier khi thiết bị mobile đồng bộ
    private async void OnDeviceUpdatedHandler()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var cutoff = DateTime.UtcNow.AddHours(-24);
            _visitsLast24h = await db.TrialLogs.CountAsync(t => t.CreatedAt >= cutoff);
            var cutoff15 = DateTime.UtcNow.AddMinutes(-15);
            _onlineDevices = await db.UserDevices.CountAsync(d => d.LastActive >= cutoff15);

            await LoadHeatmapData();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh heatmap on device update.");
        }
    }

    private async Task OnViewModeChanged(string newMode)
    {
        if (newMode == _viewMode) return;
    
        // Xóa dữ liệu cũ để giao diện không bị render sai trong lúc chờ nạp mới
        _heatmapData.Clear();
        _viewMode = newMode;
    
        await LoadHeatmapData();
    
        // Chỉ render lại sau khi _heatmapData đã được nạp đầy đủ
        StateHasChanged();
    }

    private async Task LoadHeatmapData()
    {
        // Chỉ lấy cột LastActive
        using var db = await DbFactory.CreateDbContextAsync();
        var data = new List<HeatmapDataPoint>();
        
        var activityDates = await db.UserDevices
            .Select(d => d.LastActive)
            .ToListAsync();

        var activities = activityDates.Select(dt => dt.ToVietnamTime()).ToList();

        if (_viewMode == "Week")
        {
            // Tạo Lookup dựa trên Tuple (Thứ, Giờ)
            var lookup = activities.ToLookup(dt => ((int)dt.DayOfWeek, dt.Hour));

            for (int dow = 0; dow < 7; dow++)
            {
                for (int hr = 0; hr < 24; hr++)
                {
                    data.Add(new HeatmapDataPoint
                    {
                        LabelY = DayNames[dow],
                        ValueX = hr,
                        Count = lookup[(dow, hr)].Count() // Truy xuất O(1)
                    });
                }
            }
        }
        else
        {
            var currentYear = DateTime.UtcNow.ToVietnamTime().Year;
            // Tạo Lookup dựa trên Tuple (Tháng, Tuần trong tháng)
            var lookup = activities
                .Where(dt => dt.Year == currentYear)
                .ToLookup(dt => (dt.Month, (dt.Day - 1) / 7 + 1));

            for (int m = 1; m <= 12; m++)
            {
                for (int w = 1; w <= 5; w++)
                {
                    data.Add(new HeatmapDataPoint
                    {
                        LabelY = MonthNames[m - 1],
                        ValueX = w,
                        Count = lookup[(m, w)].Count()
                    });
                }
            }
        }

        _heatmapData = data; // Gán dữ liệu mới một lần duy nhất
    }

    public void Dispose()
    {
        // Tránh rò rỉ bộ nhớ
        DataUpdateNotifier.OnDeviceUpdated -= OnDeviceUpdatedHandler;
    }
}