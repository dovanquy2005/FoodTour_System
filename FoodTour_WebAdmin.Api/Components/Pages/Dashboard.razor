@page "/"
@page "/dashboard"
@implements IDisposable
@using System.Threading
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ILogger<Dashboard> Logger
@inject FoodTour_WebAdmin.Api.Services.IDataUpdateNotifier DataUpdateNotifier
@using FoodTour_WebAdmin.Api.Data

<PageTitle>Dashboard — FoodTour Admin</PageTitle>

<MudStack Spacing="6">
    <!-- ═══════ PAGE HEADER ═══════ -->
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5" Style="font-weight: 800; color: #2D1F14;">
                🍜 Dashboard
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #8C7B6B;">
                Tổng quan hệ thống — Phố ẩm thực Vĩnh Khánh
            </MudText>
        </MudStack>
        <MudChip T="string" Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Size="MudBlazor.Size.Small"
                 Icon="@Icons.Material.Filled.CalendarToday">
            @DateTime.UtcNow.ToVietnamTime().ToString("dd/MM/yyyy")
        </MudChip>
    </MudStack>

    <!-- ═══════ STAT CARDS ═══════ -->
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="stat-card" Elevation="0"
                      Style="padding: 24px; border-radius: 16px; border: 1px solid #F0E8E0; background: linear-gradient(135deg, #FFFFFF, #FFF8F2);">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudAvatar Size="MudBlazor.Size.Medium"
                                   Style="background: linear-gradient(135deg, #E8672A, #F4A574);">
                            <MudIcon Icon="@Icons.Material.Filled.Storefront" Style="color: white;" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.h4" Style="font-weight: 800; color: #2D1F14;">@_totalShops</MudText>
                    <MudText Typo="Typo.body2" Style="color: #8C7B6B;">Tổng quán ăn</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>


        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="stat-card" Elevation="0"
                      Style="padding: 24px; border-radius: 16px; border: 1px solid #F0E8E0; background: linear-gradient(135deg, #FFFFFF, #F0FFF4);">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudAvatar Size="MudBlazor.Size.Medium"
                                   Style="background: linear-gradient(135deg, #5DAA68, #7BC87F);">
                            <MudIcon Icon="@Icons.Material.Filled.People" Style="color: white;" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.h4" Style="font-weight: 800; color: #2D1F14;">@_visitsLast24h</MudText>
                    <MudText Typo="Typo.body2" Style="color: #8C7B6B;">Lượt truy cập 24h qua</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="stat-card" Elevation="0"
                      Style="padding: 24px; border-radius: 16px; border: 1px solid #F0E8E0; background: linear-gradient(135deg, #FFFFFF, #FFFBF0);">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudAvatar Size="MudBlazor.Size.Medium"
                                   Style="background: linear-gradient(135deg, #3B82F6, #60A5FA);">
                            <MudIcon Icon="@Icons.Material.Filled.Devices" Style="color: white;" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.h4" Style="font-weight: 800; color: #2D1F14;">@_onlineDevices</MudText>
                    <MudText Typo="Typo.body2" Style="color: #8C7B6B;">Thiết bị đang online</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- ═══════ GEOGRAPHIC HEATMAP ═══════ -->
    <MudGrid Spacing="4">
        <MudItem xs="12">
            <MudPaper Elevation="0" Style="padding: 24px; border-radius: 16px; border: 1px solid #F0E8E0;">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color:#2D1F14;">
                            🗺️ Bản đồ nhiệt — Khu vực nghe thuyết minh
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color:#8C7B6B;">
                            Vị trí các quán được nghe nhiều nhất trong @(GetTimeDisplay(_heatmapHours))
                        </MudText>
                    </MudStack>

                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudSelect T="int" Value="_heatmapHours" ValueChanged="OnHeatmapHoursChanged"
                                   Label="Khoảng thời gian" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Style="min-width:130px;">
                            <MudSelectItem T="int" Value="12">12 giờ</MudSelectItem>
                            <MudSelectItem T="int" Value="24">1 ngày</MudSelectItem>
                            <MudSelectItem T="int" Value="168">7 ngày</MudSelectItem>
                            <MudSelectItem T="int" Value="720">30 ngày</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                </MudStack>

                <div @key="@("heatmap-container")" style="position:relative;">
                    @if (_heatmapPoints.Count == 0 && !_heatmapLoading)
                    {
                        <div
                            style="position:absolute; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; background:rgba(250,250,250,0.85); border-radius:12px;">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOff" Style="font-size:48px; color:#B5A899;" />
                                <MudText Typo="Typo.body2" Style="color:#8C7B6B;">
                                    Chưa có dữ liệu nghe thử trong khoảng thời gian này
                                </MudText>
                            </MudStack>
                        </div>
                    }

                    @if (_heatmapLoading)
                    {
                        <div
                            style="position:absolute; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.7); border-radius:12px;">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        </div>
                    }

                    <div id="geo-heatmap" @key="@("geo-heatmap-id")"
                         style="height:420px; border-radius:12px; border:1px solid #F0E8E0; overflow:hidden; z-index:0;">
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- ═══════ RECENT SHOPS TABLE ═══════ -->
    <MudPaper Elevation="0" Style="padding: 24px; border-radius: 16px; border: 1px solid #F0E8E0;">
        <MudStack Spacing="3">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6" Style="font-weight: 700;">🍽️ Quán ăn gần đây</MudText>
                <MudButton Href="/shops" Variant="Variant.Text" Color="MudBlazor.Color.Primary"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Xem tất cả
                </MudButton>
            </MudStack>

            <MudTable Items="_recentShops" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm"
                      Style="border-radius: 12px; overflow: hidden;">
                <HeaderContent>
                    <MudTh Style="font-weight: 700;">Tên quán</MudTh>
                    <MudTh Style="font-weight: 700;">Địa chỉ</MudTh>
                    <MudTh Style="font-weight: 700;">Đánh giá</MudTh>
                    <MudTh Style="font-weight: 700; text-align: right;">Trạng thái</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Size="MudBlazor.Size.Small" Style="background: #FFF0E6; color: #E8672A;">
                                <MudIcon Icon="@Icons.Material.Filled.Store" Size="MudBlazor.Size.Small" />
                            </MudAvatar>
                            <MudText Style="font-weight: 600;">@context.Name</MudText>
                        </MudStack>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2" Style="color: #8C7B6B;">@context.Address</MudText>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="MudBlazor.Size.Small"
                                 Style="background: #FFF0E6; color: #E8672A; font-weight: 600;">
                            ★ @context.Rating.ToString("0.0")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Success"
                                 Variant="Variant.Filled">Hoạt động
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private int _totalShops;
    private int _visitsLast24h;
    private int _onlineDevices;
    private List<ShopModel>? _recentShops;
    private bool _isDisposed = false;
    private List<object>? _allActiveShops;
    // ── Geographic Heatmap ────────────────────────────────────────────────────
    private record HeatPoint(double Lat, double Lng, int Weight);

    private List<HeatPoint> _heatmapPoints = new();
    private int _heatmapHours = 12;
    private bool _heatmapLoading = false;
    private bool _heatmapReady = false;

    // Vĩnh Khánh Street center coordinates
    private const double MapCenterLat = 10.7593;
    private const double MapCenterLng = 106.7081;

    private async Task LoadHeatmapPoints()
    {
        _heatmapLoading = true;
        StateHasChanged();

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var vnNow = DateTime.UtcNow.ToVietnamTime();
            var since = DateTime.UtcNow.AddHours(-_heatmapHours);

            var raw = await db.TrialLogs
                .Where(t => t.CreatedAt >= since
                         && t.ShopId != null
                         && t.ShopId != string.Empty)
                .Join(db.Shops,
                      t => t.ShopId,
                      s => s.Id,
                      (t, s) => new
                      {
                          s.Latitude,
                          s.Longitude,
                          ShopId = s.Id
                      })
                .ToListAsync();

            Logger.LogInformation("Raw rows: {Count}, sample: {Sample}",
                raw.Count,
                raw.FirstOrDefault() is { } r ? $"lat={r.Latitude} lng={r.Longitude} shop={r.ShopId}" : "none");

            _heatmapPoints = raw
                .GroupBy(x => new { x.ShopId, x.Latitude, x.Longitude })
                .Select(g => new HeatPoint(
                    g.Key.Latitude,
                    g.Key.Longitude,
                    g.Count()
                ))
                .Where(p => p.Lat != 0 && p.Lng != 0 && p.Weight > 0)
                .OrderByDescending(p => p.Weight)
                .ToList();

            Logger.LogInformation("Heatmap Summary: Raw Logs={RawCount} -> Unique Points={PointsCount}",
                raw.Count, _heatmapPoints.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load heatmap points.");
            _heatmapPoints = new();
        }
        finally
        {
            _heatmapLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshHeatmapOnUI()
    {
        await LoadHeatmapPoints();
        if (!_heatmapReady) return;

        if (_heatmapPoints != null && _heatmapPoints.Count > 0)
        {
            // Có dữ liệu -> Truyền mảng tọa độ sang JS để vẽ
            var jsPoints = _heatmapPoints
                .Select(p => new { lat = p.Lat, lng = p.Lng, weight = (double)p.Weight }) // Ép weight về double
                .ToList();
            await JSRuntime.InvokeVoidAsync("heatmap.update", (object)jsPoints);
        }
        else
        {
            // KHÔNG có dữ liệu -> Truyền mảng rỗng để JS xóa mảng nhiệt cũ trên bản đồ
            await JSRuntime.InvokeVoidAsync("heatmap.update", Array.Empty<object>());
        }
    }

    private async Task OnHeatmapHoursChanged(int hours)
    {
        _heatmapHours = hours;
        await RefreshHeatmapOnUI();
    }

    protected override async Task OnInitializedAsync()
    {
        DataUpdateNotifier.OnDeviceUpdated += OnDeviceUpdatedHandler;
        DataUpdateNotifier.OnTrialRecorded += OnTrialRecordedHandler;

        // Định nghĩa các hàm cục bộ để giữ code sạch sẽ và tái sử dụng Factory
        async Task<int> GetTotalShops()
        {
            using var db = await DbFactory.CreateDbContextAsync();
            return await db.Shops.CountAsync();
        }

        async Task<int> GetVisits()
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var cutoff = DateTime.UtcNow.AddHours(-24);
            return await db.TrialLogs.CountAsync(t => t.CreatedAt >= cutoff);
        }

        async Task<List<ShopModel>> GetRecentShops()
        {
            using var db = await DbFactory.CreateDbContextAsync();
            return await db.Shops
                .Include(s => s.ShopTranslations)
                .OrderByDescending(s => s.CreatedAt)
                .Take(5)
                .ToListAsync();
        }

        async Task<int> GetOnlineDevices()
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var cutoff = DateTime.UtcNow.AddSeconds(-10);
            return await db.UserDevices.CountAsync(d => d.LastActive >= cutoff);
        }

        /*async Task<int> GetOnlineDevices()
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var cutoff = DateTime.UtcNow.AddSeconds(-10);
        
            var actualCount = await db.UserDevices.CountAsync(d => d.LastActive >= cutoff);
            return actualCount * 2; 
        }*/

        async Task<List<object>> GetActiveShops()
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var shops = await db.Shops
                .Where(s => s.IsActive && s.Latitude != 0 && s.Longitude != 0)
                .Select(s => new
                {
                    s.Latitude,
                    s.Longitude,
                    Translation = s.ShopTranslations.FirstOrDefault(t => t.LanguageCode == "vi")
                })
                .ToListAsync();

            return shops.Select(s => (object)new
            {
                lat = s.Latitude,
                lng = s.Longitude,
                name = s.Translation?.Name ?? "",
                address = s.Translation?.Address ?? ""
            }).ToList();
        }

        // Thực thi song song tất cả các task
        var totalShopsTask = GetTotalShops();
        var visitsTask = GetVisits();
        var recentShopsTask = GetRecentShops();
        var onlineDevicesTask = GetOnlineDevices();
        var activeShopsTask = GetActiveShops();
        var heatmapTask = LoadHeatmapPoints(); // Giả định hàm này cũng async

        await Task.WhenAll(totalShopsTask, visitsTask, recentShopsTask, onlineDevicesTask, activeShopsTask, heatmapTask);

        // Gán giá trị
        _totalShops = totalShopsTask.Result;
        _visitsLast24h = visitsTask.Result;
        _recentShops = recentShopsTask.Result;
        _onlineDevices = onlineDevicesTask.Result;
        _allActiveShops = activeShopsTask.Result;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await JSRuntime.InvokeVoidAsync(
            "heatmap.init",
            "geo-heatmap",
            Array.Empty<object>(),
            MapCenterLat,
            MapCenterLng,
            16);

        _heatmapReady = true;

        // Push shop markers
        if (_allActiveShops != null && _allActiveShops.Any())
        {
            await JSRuntime.InvokeVoidAsync("heatmap.addShopMarkers", _allActiveShops);
        }

        // Vẽ vùng nhiệt nếu có dữ liệu
        if (_heatmapPoints != null && _heatmapPoints.Any())
        {
            var jsPoints = _heatmapPoints
                .Select(p => new { lat = p.Lat, lng = p.Lng, weight = (double)p.Weight }) // Ép weight về double
                .ToList(); // Dùng ToList() thay vì ToArray()

            await JSRuntime.InvokeVoidAsync("heatmap.update", (object)jsPoints);
        }
    }

    // Gọi bởi IDataUpdateNotifier khi thiết bị mobile đồng bộ
    private async void OnDeviceUpdatedHandler()
    {
        /*
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var cutoff24 = DateTime.UtcNow.AddHours(-24);
            _visitsLast24h = await db.TrialLogs.CountAsync(t => t.CreatedAt >= cutoff24);
            
            var cutoff10 = DateTime.UtcNow.AddSeconds(-10);
            // Lấy số lượng thực tế từ DB
            var actualOnline = await db.UserDevices.CountAsync(d => d.LastActive >= cutoff10);
            // Gán giá trị hiển thị bằng số thực tế nhân đôi
            _onlineDevices = actualOnline * 2; 
            
            await InvokeAsync(StateHasChanged);
        }
        */
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var cutoff24 = DateTime.UtcNow.AddHours(-24);
            _visitsLast24h = await db.TrialLogs.CountAsync(t => t.CreatedAt >= cutoff24);
            var cutoff10 = DateTime.UtcNow.AddSeconds(-10);
            _onlineDevices = await db.UserDevices.CountAsync(d => d.LastActive >= cutoff10);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dashboard refresh error.");
        }
    }

    // cập nhật real-time khi có log mới từ mobile
    private async void OnTrialRecordedHandler()
    {
        if (_isDisposed) return;
        try
        {
            await InvokeAsync(async () =>
            {
                if (!_isDisposed)
                {
                    await RefreshHeatmapOnUI();
                }
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Heatmap real-time refresh failed.");
        }
    }

    private string GetTimeDisplay(int hours) => hours switch
    {
        12 => "12 giờ",
        24 => "1 ngày",
        168 => "7 ngày",
        720 => "30 ngày",
        _ => $"{hours} giờ"
    };

    public void Dispose()
    {
        _isDisposed = true;
        // Tránh rò rỉ bộ nhớ
        DataUpdateNotifier.OnDeviceUpdated -= OnDeviceUpdatedHandler;
        DataUpdateNotifier.OnTrialRecorded -= OnTrialRecordedHandler;
    }
}