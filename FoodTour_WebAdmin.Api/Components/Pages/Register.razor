@page "/register"
@layout FoodTour_WebAdmin.Api.Components.Layout.PublicLayout
@inject FoodTour_WebAdmin.Api.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Đăng ký — FoodTour Owner</PageTitle>

<div class="register-container">
    <div class="glass-card">
        <!-- Logo / Header -->
        <div class="text-center mb-8">
            <div class="logo-circle mx-auto mb-4">
                <MudIcon Icon="@Icons.Material.Filled.StoreMallDirectory" Style="font-size: 40px; color: white;" />
            </div>
            <h1 class="ft-title">Đăng ký Chủ Quán</h1>
            <p class="ft-subtitle">Tạo tài khoản để quản lý thông tin quán ăn của bạn</p>
        </div>

        <!-- Form -->
        <MudForm @ref="_form" @bind-IsValid="_isFormValid">
            <MudStack Spacing="4">
                <!-- Họ tên -->
                <div class="input-group">
                    <label class="input-label">Họ và tên</label>
                    <MudTextField @bind-Value="_fullName" Variant="Variant.Outlined"
                                  Required="true" RequiredError="Vui lòng nhập họ tên"
                                  Placeholder="Nguyễn Văn A" Class="custom-input" Underline="false" />
                </div>

                <!-- Email -->
                <div class="input-group">
                    <label class="input-label">Email đăng nhập</label>
                    <MudTextField @bind-Value="_email" Variant="Variant.Outlined"
                                  Required="true" RequiredError="Vui lòng nhập Email" InputType="InputType.Email"
                                  Placeholder="owner@foodtour.com" Class="custom-input" Underline="false" />
                </div>

                <!-- Password -->
                <div class="input-group">
                    <label class="input-label">Mật khẩu</label>
                    <MudTextField @bind-Value="_password" Variant="Variant.Outlined"
                                  Required="true" RequiredError="Vui lòng nhập mật khẩu" InputType="@_passwordInput"
                                  Placeholder="••••••••" Class="custom-input" Underline="false"
                                  Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon"
                                  OnAdornmentClick="TogglePasswordVisibility" />
                </div>

                <!-- Confirm Password -->
                <div class="input-group">
                    <label class="input-label">Xác nhận mật khẩu</label>
                    <MudTextField @bind-Value="_confirmPassword" Variant="Variant.Outlined"
                                  Required="true" RequiredError="Vui lòng xác nhận mật khẩu" InputType="InputType.Password"
                                  Placeholder="••••••••" Class="custom-input" Underline="false"
                                  Validation="@((string v) => v == _password ? null : "Mật khẩu xác nhận không khớp")" />
                </div>

                <!-- ─── Divider: Thông tin quán ─── -->
                <div class="section-divider">
                    <div class="divider-line"></div>
                    <span class="divider-label">
                        <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" Style="vertical-align:middle; margin-right:4px;" />
                        Thông tin Quán
                    </span>
                    <div class="divider-line"></div>
                </div>
                <p class="section-hint">
                    Hệ thống sẽ tự động tạo hồ sơ quán và đợi Admin kiểm duyệt.
                </p>

                <!-- Tên quán -->
                <div class="input-group">
                    <label class="input-label">Tên quán ăn <span class="required-star">*</span></label>
                    <MudTextField @bind-Value="_shopName" Variant="Variant.Outlined"
                                  Required="true" RequiredError="Vui lòng nhập tên quán"
                                  Placeholder="Ốc Oanh, Lẩu Dê Vinh Khánh..."
                                  Class="custom-input" Underline="false" />
                </div>

                <!-- Địa chỉ quán -->
                <div class="input-group">
                    <label class="input-label">Địa chỉ quán <span class="required-star">*</span></label>
                    <MudTextField @bind-Value="_shopAddress" Variant="Variant.Outlined"
                                  Required="true" RequiredError="Vui lòng nhập địa chỉ"
                                  Placeholder="123 Vĩnh Khánh, Phường 8, Quận 4..."
                                  Class="custom-input" Underline="false" />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="error-box">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />
                        <span>@_errorMessage</span>
                    </div>
                }

                <!-- Submit -->
                <button type="button" class="ft-btn-primary" disabled="@(!_isFormValid || _isLoading)" @onclick="HandleRegister">
                    @if (_isLoading)
                    {
                        <div class="spinner"></div>
                        <span>Đang tạo tài khoản...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" Class="mr-2" />
                        <span>Tạo tài khoản</span>
                    }
                </button>
            </MudStack>
        </MudForm>

        <div class="footer-text">
            Đã có tài khoản? <a href="/login">Đăng nhập ngay</a>
        </div>
    </div>
</div>

<style>
    /* ═══════ NỀN ═══════ */
    .register-container {
        min-height: 100vh;
        width: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background-color: #0f172a;
        background-image:
            radial-gradient(at 0% 100%, hsla(201,100%,60%,1) 0, transparent 50%),
            radial-gradient(at 50% 0%,  hsla(28,100%,74%,1)  0, transparent 50%),
            radial-gradient(at 100% 100%, hsla(255,80%,70%,1) 0, transparent 50%);
        box-sizing: border-box;
        overflow: hidden;
        position: relative;
    }
    .register-container::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        z-index: 1;
    }

    /* ═══════ GLASSMORPHISM CARD ═══════ */
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 24px;
        padding: 48px;
        width: 100%;
        max-width: 520px; /* Wider to accommodate shop fields */
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255,255,255,0.2) inset;
        z-index: 2;
        animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .logo-circle {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 12px 24px rgba(59,130,246,0.3), inset 0 2px 0 rgba(255,255,255,0.2);
        transform: rotate(-10deg);
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .glass-card:hover .logo-circle {
        transform: rotate(0deg) scale(1.05);
    }

    /* ═══════ TYPOGRAPHY ═══════ */
    .ft-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: #1e293b;
        margin: 0;
        letter-spacing: -0.5px;
    }
    .ft-subtitle {
        color: #64748b;
        font-size: 0.9rem;
        margin-top: 8px;
    }

    /* ═══════ FORM INPUTS ═══════ */
    .input-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .input-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #334155;
        margin-left: 2px;
    }
    .required-star {
        color: #ef4444;
        margin-left: 2px;
    }

    /* ═══════ SECTION DIVIDER ═══════ */
    .section-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 4px 0 0;
    }
    .divider-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(to right, transparent, #e2e8f0, transparent);
    }
    .divider-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #94a3b8;
        letter-spacing: 0.5px;
        white-space: nowrap;
        text-transform: uppercase;
    }
    .section-hint {
        font-size: 0.8rem;
        color: #94a3b8;
        margin: -4px 0 0;
        line-height: 1.4;
    }

    ::deep .custom-input .mud-input {
        background-color: #f8fafc !important;
        border-radius: 12px;
        transition: all 0.2s ease;
    }
    ::deep .custom-input .mud-input-outlined-border {
        border-color: #e2e8f0;
        border-radius: 12px;
    }
    ::deep .custom-input .mud-input:focus-within {
        background-color: #ffffff !important;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }
    ::deep .custom-input .mud-input-outlined.mud-input:focus-within .mud-input-outlined-border {
        border-color: #3b82f6;
        border-width: 2px;
    }

    /* ═══════ ERROR & BUTTON ═══════ */
    .error-box {
        background: #fef2f2;
        color: #b91c1c;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #fecaca;
        animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
    }

    .ft-btn-primary {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: white;
        border: none;
        padding: 16px;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 700;
        width: 100%;
        margin-top: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 25px -5px rgba(29, 78, 216, 0.4);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .ft-btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 20px 30px -10px rgba(29, 78, 216, 0.5);
    }
    .ft-btn-primary:active:not(:disabled) { transform: translateY(0); }
    .ft-btn-primary:disabled {
        background: #cbd5e1;
        box-shadow: none;
        cursor: not-allowed;
        opacity: 0.7;
    }

    .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        border-top-color: white;
        animation: spin 0.8s linear infinite;
        margin-right: 8px;
    }

    .footer-text {
        text-align: center;
        margin-top: 28px;
        font-size: 0.85rem;
        color: #64748b;
    }
    .footer-text a {
        color: #3b82f6;
        font-weight: 600;
        text-decoration: none;
    }
    .footer-text a:hover { text-decoration: underline; }

    /* ═══════ ANIMATIONS ═══════ */
    @@keyframes slideUpFade {
        from { opacity: 0; transform: translateY(40px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes shake {
        10%, 90% { transform: translate3d(-1px, 0, 0); }
        20%, 80% { transform: translate3d(2px, 0, 0); }
        30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
        40%, 60%       { transform: translate3d(4px, 0, 0); }
    }
</style>

@code {
    private MudForm? _form;
    private bool _isFormValid;
    private string _fullName = "";
    private string _email = "";
    private string _password = "";
    private string _confirmPassword = "";
    private string _shopName = "";
    private string _shopAddress = "";
    private string _errorMessage = "";
    private bool _isLoading = false;

    private bool _isShowPassword = false;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        _isShowPassword = !_isShowPassword;
        _passwordInputIcon = _isShowPassword
            ? Icons.Material.Filled.Visibility
            : Icons.Material.Filled.VisibilityOff;
        _passwordInput = _isShowPassword ? InputType.Text : InputType.Password;
    }

    private async Task HandleRegister()
    {
        _errorMessage = "";

        // Validate confirm password
        if (_password != _confirmPassword)
        {
            _errorMessage = "Mật khẩu xác nhận không khớp.";
            return;
        }

        _isLoading = true;
        try
        {
            // Gọi overload mới nhận RegisterRequest — tạo User + Shop trong 1 Transaction
            await AuthService.RegisterAsync(new FoodTour_WebAdmin.Api.DTOs.RegisterRequest
            {
                Email           = _email.Trim(),
                FullName        = _fullName.Trim(),
                Password        = _password,
                ConfirmPassword = _confirmPassword,
                ShopName        = _shopName.Trim(),
                ShopAddress     = _shopAddress.Trim(),
            });

            Snackbar.Add("✅ Tạo tài khoản thành công! Hồ sơ quán đang được Admin kiểm duyệt. Hãy đăng nhập.", Severity.Success);
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
