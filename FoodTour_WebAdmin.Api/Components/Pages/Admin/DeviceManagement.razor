@page "/admin/devices"
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject FoodTour_WebAdmin.Api.Services.IDataUpdateNotifier DataUpdateNotifier
@using FoodTour_WebAdmin.Api.Models
@using FoodTour_WebAdmin.Api.Extensions
@using Microsoft.EntityFrameworkCore
@using ApexCharts

<PageTitle>Quản lý thiết bị — FoodTour Admin</PageTitle>

@* ══ HEADER ══ *@
<div
    style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px;">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:800; color:#1e293b; margin-bottom:4px;">
            📱 Quản lý thiết bị Mobile
        </MudText>
        <MudText Typo="Typo.body2" Style="color:#64748b;">
            Theo dõi và kiểm soát các thiết bị đã đồng bộ lên hệ thống
        </MudText>
    </div>

    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
        <MudChip T="string" Color="MudBlazor.Color.Info" Icon="@Icons.Material.Filled.Devices" Style="font-weight:700;">
            @_devices.Count tổng cộng
        </MudChip>
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined"
                   OnClick="@(() => LoadDataAsync(true))" Disabled="_isLoading">
            Làm mới
        </MudButton>
    </MudStack>
</div>

@* ══ HEATMAP CARD ══ *@
<MudPaper Elevation="0" Style="border-radius:16px; border:1px solid #f1f5f9; padding:24px; margin-bottom:24px; background:#fff;">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <div>
            <MudText Typo="Typo.h6" Style="font-weight:800; color:#1e293b;">
                🔥 Hoạt động thiết bị (@(_viewMode == "Week" ? "Theo giờ trong tuần" : "Theo tuần trong năm"))
            </MudText>
        </div>
        <MudToggleGroup T="string" Value="@_viewMode" ValueChanged="OnViewModeChanged"
                        Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Primary" Variant="Variant.Outlined">
            <MudToggleItem Value="@("Week")">Theo Tuần</MudToggleItem>
            <MudToggleItem Value="@("Month")">Theo Năm</MudToggleItem>
        </MudToggleGroup>
    </MudStack>

    @if (_heatmapData != null && _heatmapData.Any())
    {
        <ApexChart @key="_viewMode" TItem="HeatmapDataPoint" Height="360" Options="_heatmapOptions">
            @if (_viewMode == "Week")
            {
                @foreach (var day in DayNames)
                {
                    <ApexPointSeries TItem="HeatmapDataPoint"
                                     Items="@(_heatmapData.Where(d => d.LabelY == day).OrderBy(d => d.ValueX).ToList())"
                                     Name="@day" SeriesType="SeriesType.Heatmap"
                                     XValue="@(e => e.ValueX.ToString())"
                                     YValue="@(e => (decimal)e.Count)" />
                }
            }
            else
            {
                @foreach (var month in MonthNames)
                {
                    <ApexPointSeries TItem="HeatmapDataPoint"
                                     Items="@(_heatmapData.Where(d => d.LabelY == month).OrderBy(d => d.ValueX).ToList())"
                                     Name="@month" SeriesType="SeriesType.Heatmap"
                                     XValue="@(e => "T" + e.ValueX)"
                                     YValue="@(e => (decimal)e.Count)" />
                }
            }
        </ApexChart>
    }
    else
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center"
                  Style="height:360px; background:#f8fafc; border-radius:12px;">
            <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Size="MudBlazor.Size.Medium" />
            <MudText Typo="Typo.caption" Class="mt-2" Style="color:#94a3b8;">Đang tải dữ liệu hoạt động...</MudText>
        </MudStack>
    }
</MudPaper>

@* ══ SEARCH BAR ══ *@
<MudTextField @bind-Value="_search" Immediate="true" Placeholder="Tìm DeviceId, tên thiết bị..."
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined"
              Margin="Margin.Dense" Style="max-width:440px; margin-bottom:20px;" />

@* ══ LOADING ══ *@
@if (_isLoading)
{
    <div style="display:flex; gap:16px; align-items:center; padding:48px 0;">
        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" />
        <MudText Style="color:#64748b;">Đang tải danh sách thiết bị...</MudText>
    </div>
}
else
{
    @* ══ BẢNG THIẾT BỊ ══ *@
    <MudTable T="UserDeviceModel" Items="@FilteredDevices" Hover="true" Striped="true" Elevation="2"
              Style="border-radius:16px; overflow:hidden;" Loading="_isLoading">
        <ColGroup>
            <col style="width:25%;" />
            <col style="width:25%;" />
            <col style="width:15%;" />
            <col style="width:20%;" />
            <col style="width:15%;" />
        </ColGroup>
        <HeaderContent>
            <MudTh Style="@_thStyle">Device ID</MudTh>
            <MudTh Style="@_thStyle">Tên thiết bị</MudTh>
            <MudTh Style="@_thStyle">Nền tảng</MudTh>
            <MudTh Style="@_thStyle">Hoạt động cuối</MudTh>
            <MudTh Style="@_thStyle">Kết nối</MudTh>
        </HeaderContent>
        <RowTemplate>
            @* ── DeviceId ── *@
            <MudTd DataLabel="Device ID">
                <MudText Typo="Typo.body2"
                         Style="font-family:monospace; font-size:0.78rem; color:#1e293b; word-break:break-all;">
                    @context.DeviceId
                </MudText>
                @if (context.UserId != null)
                {
                    <MudText Typo="Typo.caption" Style="color:#94a3b8;">
                        User: @context.UserId[..8]...
                    </MudText>
                }
            </MudTd>

            @* ── Tên thiết bị ── *@
            <MudTd DataLabel="Tên thiết bị">
                <MudText Typo="Typo.body2" Style="font-weight:600; color:#1e293b;">
                    @context.DeviceName
                </MudText>
            </MudTd>

            @* ── Nền tảng ── *@
            <MudTd DataLabel="Nền tảng">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    @if ("Android".Equals(context.Platform, StringComparison.OrdinalIgnoreCase))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Android" Style="color:#34A853;" />
                        <MudText Typo="Typo.body2">Android</MudText>
                    }
                    else if (context.Platform != null && (context.Platform.Contains("iOS",
                StringComparison.OrdinalIgnoreCase) || context.Platform.Contains("Mac",
                StringComparison.OrdinalIgnoreCase)))
                    {
                        <MudIcon Icon="@Icons.Custom.Brands.Apple" Style="color:#64748b;" />
                        <MudText Typo="Typo.body2">@context.Platform</MudText>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Smartphone" Style="color:#94a3b8;" />
                        <MudText Typo="Typo.body2">@(context.Platform ?? "Unknown")</MudText>
                    }
                </MudStack>
            </MudTd>

            @* ── LastActive ── *@
            <MudTd DataLabel="Hoạt động cuối">
                <MudText Typo="Typo.body2" Style="color:#475569;">
                    @context.LastActive.ToVietnamTime().ToString("dd/MM/yyyy")
                </MudText>
                <MudText Typo="Typo.caption" Style="color:#94a3b8;">
                    @context.LastActive.ToVietnamTime().ToString("HH:mm:ss")
                </MudText>
            </MudTd>

            @* ── Kết nối (Heartbeat) ── *@
            <MudTd DataLabel="Kết nối">
                @if ((DateTime.UtcNow - context.LastActive).TotalSeconds <= 10)
                {
                    <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Success" Icon="@Icons.Material.Filled.Wifi"
                             Style="font-weight:700;">
                        Online
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Default" Icon="@Icons.Material.Filled.WifiOff"
                             Style="font-weight:700; color:#94a3b8;">
                        Offline
                    </MudChip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Style="padding:48px 0;">
                <MudIcon Icon="@Icons.Material.Filled.DevicesOther" Style="font-size:64px; color:#cbd5e1;" />
                <MudText Typo="Typo.h6" Style="font-weight:700; color:#94a3b8;">
                    Chưa có thiết bị nào
                </MudText>
                <MudText Typo="Typo.body2" Style="color:#b0bec5;">
                    Các thiết bị sẽ xuất hiện khi Mobile gọi API sync lần đầu.
                </MudText>
            </MudStack>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" RowsPerPageString="Số dòng mỗi trang:"
                           InfoFormat="{first_item}-{last_item} của {all_items}" />
        </PagerContent>
    </MudTable>
}

@code {
    // ── State ──────────────────────────────────────────────────────────────
    private bool _isLoading = true;
    private string _search = string.Empty;
    private List<UserDeviceModel> _devices = new();
    private int _onlineCount = 0;
    private const string _thStyle = "background:#f8fafc; font-weight:700; color:#475569;";

    // ── Heatmap state ───────────────────────────────────────────────────────
    private string _viewMode = "Week";
    private static readonly string[] DayNames = { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
    private static readonly string[] MonthNames = { "Th1","Th2","Th3","Th4","Th5","Th6","Th7","Th8","Th9","Th10","Th11","Th12" };
    private List<HeatmapDataPoint> _heatmapData = new();

    private ApexChartOptions<HeatmapDataPoint> _heatmapOptions = new()
    {
        PlotOptions = new PlotOptions
        {
            Heatmap = new PlotOptionsHeatmap
            {
                Distributed = true,
                Radius = 4,
                EnableShades = true,
                ShadeIntensity = 0.5,
                ColorScale = new PlotOptionsHeatmapColorScale
                {
                    Ranges = new List<PlotOptionsHeatmapColorScaleRange>
                    {
                        new() { From = 0,  To = 0,    Name = "Không có",   Color = "#F3F4F6" },
                        new() { From = 1,  To = 5,    Name = "Thấp",       Color = "#FCA5A5" },
                        new() { From = 6,  To = 15,   Name = "Trung bình", Color = "#EF4444" },
                        new() { From = 16, To = 30,   Name = "Cao",        Color = "#991B1B" },
                        new() { From = 31, To = 9999, Name = "Rất cao",    Color = "#7F1D1D" }
                    }
                }
            }
        },
        States = new States
        {
            Hover  = new StatesHover  { Filter = new StatesFilter { Type = (StatesFilterType)0 } },
            Active = new StatesActive { AllowMultipleDataPointsSelection = false, Filter = new StatesFilter { Type = (StatesFilterType)0 } }
        },
        Legend = new Legend { Show = true, Position = LegendPosition.Bottom },
        DataLabels = new DataLabels { Enabled = false }
    };

    private class HeatmapDataPoint
    {
        public string LabelY { get; set; } = string.Empty;
        public int ValueX    { get; set; }
        public int Count     { get; set; }
    }

    // ── Derived ────────────────────────────────────────────────────────────

    private IEnumerable<UserDeviceModel> FilteredDevices =>
        string.IsNullOrWhiteSpace(_search)
            ? _devices.OrderByDescending(d => d.LastActive)
            : _devices
                .Where(d =>
                    d.DeviceId.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    d.DeviceName.Contains(_search, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(d => d.LastActive);

    // ── Lifecycle ──────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        DataUpdateNotifier.OnDeviceUpdated += OnDeviceUpdatedHandler;
        await Task.WhenAll(LoadDataAsync(true), LoadHeatmapData());
    }

    private async Task LoadDataAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            _isLoading = true;
            StateHasChanged();
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _devices = await db.UserDevices.OrderByDescending(d => d.LastActive).ToListAsync();
            _onlineCount = _devices.Count(d => (DateTime.UtcNow - d.LastActive).TotalSeconds <= 10);
        }
        finally
        {
            if (showLoading) _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadHeatmapData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var data = new List<HeatmapDataPoint>();

        var activityDates = await db.UserDevices
            .Select(d => d.LastActive)
            .ToListAsync();

        var activities = activityDates.Select(dt => dt.ToVietnamTime()).ToList();

        if (_viewMode == "Week")
        {
            var lookup = activities.ToLookup(dt => ((int)dt.DayOfWeek, dt.Hour));
            for (int dow = 0; dow < 7; dow++)
                for (int hr = 0; hr < 24; hr++)
                    data.Add(new HeatmapDataPoint { LabelY = DayNames[dow], ValueX = hr, Count = lookup[(dow, hr)].Count() });
        }
        else
        {
            var currentYear = DateTime.UtcNow.ToVietnamTime().Year;
            var lookup = activities
                .Where(dt => dt.Year == currentYear)
                .ToLookup(dt => (dt.Month, (dt.Day - 1) / 7 + 1));

            for (int m = 1; m <= 12; m++)
                for (int w = 1; w <= 5; w++)
                    data.Add(new HeatmapDataPoint { LabelY = MonthNames[m - 1], ValueX = w, Count = lookup[(m, w)].Count() });
        }

        _heatmapData = data;
    }

    private async Task OnViewModeChanged(string newMode)
    {
        if (newMode == _viewMode) return;
        _heatmapData.Clear();
        _viewMode = newMode;
        await LoadHeatmapData();
        StateHasChanged();
    }

    private async void OnDeviceUpdatedHandler()
    {
        await InvokeAsync(async () =>
        {
            await Task.WhenAll(LoadDataAsync(false), LoadHeatmapData());
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        DataUpdateNotifier.OnDeviceUpdated -= OnDeviceUpdatedHandler;
    }
}
