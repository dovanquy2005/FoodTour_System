@inherits LayoutComponentBase
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
<MudThemeProvider Theme="_foodTourTheme" IsDarkMode="false" />

<MudLayout>
    <!-- ═══════ APP BAR ═══════ -->
    <MudAppBar Elevation="0" Style="background: linear-gradient(135deg, #E8672A, #C85520); border-bottom: 1px solid rgba(255,255,255,0.1);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Fastfood" Size="Size.Large" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Style="font-weight: 700; letter-spacing: -0.5px; line-height: 1.2;">
                    FoodTour Admin
                </MudText>
                <MudText Typo="Typo.caption" Style="opacity: 0.8; font-size: 0.7rem;">
                    Vinh Khanh Street Eats
                </MudText>
            </MudStack>
        </MudStack>
        <MudSpacer />
        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Circle"
                 Style="color: white; font-size: 0.75rem;">
            Online
        </MudChip>
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
        
        <!-- User Dropdown Menu -->
        <AuthorizeView Context="authState">
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="ml-2">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" 
                                   OnClick="@context.ToggleAsync"
                                   Style="text-transform: none; padding: 4px 12px; border-radius: 20px; background: rgba(255,255,255,0.1);">
                            <MudAvatar Size="Size.Small" Style="background: rgba(255,255,255,0.2); margin-right: 8px;">
                                @if (!string.IsNullOrEmpty(authState.User.Identity?.Name))
                                {
                                    <span>@authState.User.Identity.Name.Substring(0, 1).ToUpper()</span>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                                }
                            </MudAvatar>
                            <span style="font-weight: 600;">@authState.User.Identity?.Name</span>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Class="ml-1" />
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <div style="padding: 16px; border-bottom: 1px solid #F0E8E0; min-width: 200px;">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #2D1F14;">@authState.User.Identity?.Name</MudText>
                            <MudText Typo="Typo.caption" Style="color: #8C7B6B;">@authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Style="margin-top: 8px; font-size: 0.65rem; height: 20px;">
                                @authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                            </MudChip>
                        </div>
                        <MudMenuItem Icon="@Icons.Material.Filled.Person" Style="font-size: 0.9rem; font-weight: 500;">Hồ sơ (Profile)</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Settings" Style="font-size: 0.9rem; font-weight: 500;">Cài đặt (Settings)</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="Logout" Style="font-size: 0.9rem; font-weight: 500; color: #D94F4F;">Đăng xuất</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Text" Color="Color.Inherit" Style="text-transform: none; margin-left: 8px;">Đăng nhập</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <!-- ═══════ SIDE DRAWER ═══════ -->
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2"
               Style="background: #FFFFFF; border-right: 1px solid #F0E8E0;">
        <NavMenu />
    </MudDrawer>

    <!-- ═══════ MAIN CONTENT ═══════ -->
    <MudMainContent Style="background: #FBF7F2; min-height: 100vh;">
        <div style="padding: 24px;">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private MudTheme _foodTourTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#E8672A",
            PrimaryDarken = "#C85520",
            PrimaryLighten = "#F4A574",
            Secondary = "#FFF0E6",
            Tertiary = "#D4A574",
            Background = "#FBF7F2",
            Surface = "#FFFFFF",
            AppbarBackground = "#E8672A",
            AppbarText = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#2D1F14",
            TextPrimary = "#2D1F14",
            TextSecondary = "#8C7B6B",
            Success = "#5DAA68",
            Error = "#D94F4F",
            Warning = "#E8A838",
            Info = "#5B8FD4",
            Divider = "#F0E8E0",
            TableStriped = "#FBF7F2",
            ActionDefault = "#8C7B6B",
            ActionDisabled = "#B5A899",
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px",
        },
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void Logout()
    {
        var customAuthStateProvider = (FoodTour_WebAdmin.Api.Services.CustomAuthStateProvider)AuthStateProvider;
        customAuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }
}
