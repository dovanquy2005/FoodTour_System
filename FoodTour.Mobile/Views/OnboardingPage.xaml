<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:FoodTour.Mobile.Extensions"
             x:Class="FoodTour.Mobile.Views.OnboardingPage"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto" Margin="20, 20, 20, 30">
        
        <VerticalStackLayout Grid.Row="0" Spacing="15" VerticalOptions="Center">
            
            <Border BackgroundColor="{StaticResource Surface}"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    HeightRequest="220"
                    Margin="0,0,0,20"
                    Shadow="{Shadow Radius=12, Opacity=0.08, Offset='0,6'}">
                <Label Text="{ext:Translate Onboarding_ImagePlaceholder}" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       TextColor="{StaticResource TextSecondary}"/>
            </Border>

            <!-- Title -->
            <Label Text="{ext:Translate Onboarding_Title}"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalTextAlignment="Center"
                   LineHeight="1.2"/>

            <!-- Description -->
            <Label Text="{ext:Translate Onboarding_Description}"
                   FontSize="15"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalTextAlignment="Center"
                   LineHeight="1.4"
                   Margin="10, 10"/>

            <!-- Info Text -->
            <Label Text="{ext:Translate Onboarding_DataSize}"
                   FontSize="13"
                   FontAttributes="Italic"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center"
                   Margin="0, -5, 0, 10"/>

            <!-- Download Progress Area (Hidden by default) -->
            <VerticalStackLayout x:Name="ProgressArea" 
                                 IsVisible="False" 
                                 Spacing="10" 
                                 Margin="0, 10, 0, 0">
                <ProgressBar x:Name="DownloadProgressBar" 
                             Progress="0" 
                             ProgressColor="{StaticResource Primary}" 
                             HeightRequest="8"/>
                <Label x:Name="DownloadStatusLabel" 
                       Text="{ext:Translate Common_Loading}" 
                       FontSize="13" 
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Buttons Area (Card views) -->
        <VerticalStackLayout x:Name="ButtonsArea" Grid.Row="1" Spacing="16">
            
            <!-- Offline/Recommended Card -->
            <Border StrokeThickness="1"
                    Stroke="{StaticResource CardBorder}"
                    BackgroundColor="{StaticResource Surface}"
                    StrokeShape="RoundRectangle 16"
                    Padding="16, 12"
                    Shadow="{Shadow Radius=10, Opacity=0.05, Offset='0,4'}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDownloadOfflineClicked" />
                </Border.GestureRecognizers>
                
                <Grid ColumnDefinitions="Auto, *">
                    <Label Grid.Column="0" Text="📥" FontSize="26" VerticalOptions="Center" Margin="0,0,16,0"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{ext:Translate Onboarding_OfflineTitle}" 
                               FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{ext:Translate Onboarding_OfflineDesc}" 
                               FontSize="13" TextColor="{StaticResource TextSecondary}" LineHeight="1.2" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Online Card -->
            <Border StrokeThickness="1"
                    Stroke="{StaticResource CardBorder}"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="16, 12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnListenOnlineClicked" />
                </Border.GestureRecognizers>
                
                <Grid ColumnDefinitions="Auto, *">
                    <Label Grid.Column="0" Text="🎧" FontSize="26" VerticalOptions="Center" Margin="0,0,16,0"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{ext:Translate Onboarding_OnlineTitle}" 
                               FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{ext:Translate Onboarding_OnlineDesc}" 
                               FontSize="13" TextColor="{StaticResource TextSecondary}" LineHeight="1.2" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            
        </VerticalStackLayout>
    </Grid>
</ContentPage>
