<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
			 xmlns:viewmodels="clr-namespace:FoodTour.Mobile.ViewModels"
			 xmlns:ext="clr-namespace:FoodTour.Mobile.Extensions"
			 xmlns:controls="clr-namespace:FoodTour.Mobile.Controls"
			 x:Class="FoodTour.Mobile.Views.MapPage"
			 x:DataType="viewmodels:MapViewModel"
			 Shell.NavBarIsVisible="False"
			 Title="{ext:Translate Map_Title}">

	<Grid>
		<!-- Bản đồ chính -->
		<maps:Map x:Name="MainMap"
				  MapType="Street"
				  IsShowingUser="True"/>

		<!-- Global Audio Player Overlay -->
		<controls:FloatingAudioPlayer />
	</Grid>
</ContentPage>