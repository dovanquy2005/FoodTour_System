<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:FoodTour.Mobile.Extensions"
             xmlns:vm="clr-namespace:FoodTour.Mobile.ViewModels"
             xmlns:models="clr-namespace:FoodTour.Mobile.Models"
             x:Class="FoodTour.Mobile.Views.AlertsPage"
             x:Name="ThisPage"
             x:DataType="vm:AlertsViewModel"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">
	<Grid RowDefinitions="Auto, *" Margin="20, 25, 20, 0">

		<!-- Header -->
		<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,8,0,18">
			<Label Grid.Column="0"
			       Text="{ext:Translate Alert_Title}"
			       TextColor="{StaticResource TextPrimary}"
			       FontSize="24"
			       FontAttributes="Bold"
			       VerticalOptions="Center"/>
			
			<Button Grid.Column="1"
			        Text="🗑️ Xóa"
			        TextColor="{StaticResource Primary}"
			        BackgroundColor="Transparent"
			        FontAttributes="Bold"
			        Padding="0"
			        HeightRequest="36"
			        Command="{Binding ClearNotificationsCommand}"
			        VerticalOptions="Center"/>
		</Grid>

		<!-- Danh sách thông báo với Pull-to-Refresh -->
		<RefreshView Grid.Row="1"
		             Command="{Binding RefreshNotificationsCommand}"
		             IsRefreshing="{Binding IsRefreshing}">
			<Grid>
				<!-- Loading indicator -->
				<ActivityIndicator IsRunning="{Binding IsLoading}"
				                   IsVisible="{Binding IsLoading}"
				                   HorizontalOptions="Center"
				                   VerticalOptions="Center"
				                   Color="{StaticResource Primary}"/>

				<!-- CollectionView hiển thị danh sách thông báo -->
				<CollectionView ItemsSource="{Binding Notifications}"
				                IsVisible="True"
				                SelectionMode="None">
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="models:NotificationModel">
							<Border BackgroundColor="{StaticResource Surface}"
							        StrokeShape="RoundRectangle 16"
							        Stroke="Transparent"
							        StrokeThickness="0"
							        Padding="16, 14"
							        Margin="0,0,0,16"
							        Shadow="{Shadow Radius=10, Opacity=0.04, Offset='0,4'}">
								<Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *" ColumnSpacing="16" RowSpacing="6">

									<!-- Icon trạng thái hiện đại hơn -->
									<Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
									        WidthRequest="48" HeightRequest="48"
									        StrokeThickness="0"
									        StrokeShape="Ellipse"
									        VerticalOptions="Start">
										<Border.Triggers>
											<DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Available">
												<Setter Property="BackgroundColor" Value="#FFF3E0"/>
											</DataTrigger>
											<DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Downloading">
												<Setter Property="BackgroundColor" Value="#E3F2FD"/>
											</DataTrigger>
											<DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Updated">
												<Setter Property="BackgroundColor" Value="#E8F5E9"/>
											</DataTrigger>
											<DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Error">
												<Setter Property="BackgroundColor" Value="#FFEBEE"/>
											</DataTrigger>
										</Border.Triggers>
										<Label HorizontalOptions="Center" VerticalOptions="Center" FontSize="22">
											<Label.Triggers>
												<DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Available">
													<Setter Property="Text" Value="🚀"/>
												</DataTrigger>
												<DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Downloading">
													<Setter Property="Text" Value="⏬"/>
												</DataTrigger>
												<DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Updated">
													<Setter Property="Text" Value="✨"/>
												</DataTrigger>
												<DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Error">
													<Setter Property="Text" Value="⚠️"/>
												</DataTrigger>
											</Label.Triggers>
										</Label>
									</Border>

									<!-- Tiêu đề động tùy theo trạng thái -->
									<Label Grid.Column="1" Grid.Row="0"
									       TextColor="{StaticResource TextPrimary}"
									       FontSize="16"
									       FontAttributes="Bold"
									       LineBreakMode="TailTruncation">
										<Label.Triggers>
											<DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Available">
												<Setter Property="Text" Value="{ext:Translate Notify_UpdateAvailable}"/>
											</DataTrigger>
											<DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Downloading">
												<Setter Property="Text" Value="{ext:Translate Notify_UpdateAvailable}"/>
											</DataTrigger>
											<DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Error">
												<Setter Property="Text" Value="{ext:Translate Notify_UpdateAvailable}"/>
											</DataTrigger>
											<DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Updated">
												<Setter Property="Text" Value="{ext:Translate Notify_SyncComplete}"/>
											</DataTrigger>
										</Label.Triggers>
									</Label>

									<!-- Mô tả: nhẹ nhàng, text nhỏ hơn -->
									<Label Grid.Column="1" Grid.Row="1"
									       TextColor="{StaticResource TextSecondary}"
									       FontSize="13"
									       Opacity="0.8"
									       LineHeight="1.2">
										<Label.FormattedText>
											<FormattedString>
												<Span Text="{Binding Description}"/>
												<Span Text=" "/>
												<Span Text="{ext:Translate Notify_DataUpdateDesc}"/>
												<Span Text=" • "/>
												<Span Text="{Binding SizeDisplay}"/>
											</FormattedString>
										</Label.FormattedText>
									</Label>

									<!-- Nút hành động thanh thoát hơn -->
									<Grid Grid.Column="1" Grid.Row="2" Margin="0,8,0,0">
										<!-- Nút Cập nhật ngay -->
										<Button x:DataType="{x:Null}"
										        Text="{ext:Translate Notify_UpdateBtn}"
										        BackgroundColor="#FF9800"
										        TextColor="White"
										        FontSize="13"
										        FontAttributes="Bold"
										        HeightRequest="36"
										        CornerRadius="18"
										        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DownloadUpdateCommand}"
										        CommandParameter="{Binding .}"
										        HorizontalOptions="Start"
												Padding="20,0">
											<Button.Triggers>
												<DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Downloading">
													<Setter Property="IsVisible" Value="False"/>
												</DataTrigger>
												<DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Updated">
													<Setter Property="IsVisible" Value="False"/>
												</DataTrigger>
											</Button.Triggers>
										</Button>

										<!-- Trạng thái Đang tải... -->
										<HorizontalStackLayout Spacing="8" 
										                        HorizontalOptions="Start" 
										                        VerticalOptions="Center"
										                        IsVisible="False">
											<HorizontalStackLayout.Triggers>
												<DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding Status}" Value="Downloading">
													<Setter Property="IsVisible" Value="True"/>
												</DataTrigger>
											</HorizontalStackLayout.Triggers>
											<ActivityIndicator IsRunning="True" 
											                   Color="{StaticResource Primary}" 
											                   WidthRequest="16" HeightRequest="16"/>
											<Label Text="{ext:Translate Notify_Downloading}"
											       TextColor="{StaticResource Primary}"
											       FontSize="13"
											       FontAttributes="Bold"
											       VerticalOptions="Center"/>
										</HorizontalStackLayout>

										<!-- Badge Đã cập nhật -->
										<Label Text="{Binding CreatedAtVN, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
										       TextColor="{StaticResource TextSecondary}"
										       FontSize="12"
											   Opacity="0.6"
										       FontAttributes="Italic"
										       VerticalOptions="Center"
											   HorizontalOptions="Start"
											   IsVisible="False">
											<Label.Triggers>
												<DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Updated">
													<Setter Property="IsVisible" Value="True"/>
												</DataTrigger>
											</Label.Triggers>
										</Label>
									</Grid>
								</Grid>
							</Border>
						</DataTemplate>
					</CollectionView.ItemTemplate>

					<!-- Empty state khi không có thông báo -->
					<CollectionView.EmptyView>
						<VerticalStackLayout Margin="0,60,0,0" HorizontalOptions="Center" Spacing="8">
							<Label Text="🔔" FontSize="48" HorizontalOptions="Center" Opacity="0.35"/>
							<Label Text="{ext:Translate Notify_EmptyState}"
							       TextColor="{StaticResource TextTertiary}"
							       FontSize="14"
							       HorizontalOptions="Center"/>
							<Label Text="{ext:Translate Notify_PullToRefresh}"
							       TextColor="{StaticResource TextTertiary}"
							       FontSize="12"
							       HorizontalOptions="Center"
							       Opacity="0.6"/>
						</VerticalStackLayout>
					</CollectionView.EmptyView>
				</CollectionView>
			</Grid>
		</RefreshView>
	</Grid>
</ContentPage>