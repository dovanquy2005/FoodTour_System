<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodTour.Mobile.Models"
             xmlns:viewmodels="clr-namespace:FoodTour.Mobile.ViewModels"
             xmlns:ext="clr-namespace:FoodTour.Mobile.Extensions"
             xmlns:controls="clr-namespace:FoodTour.Mobile.Controls"
             x:Class="FoodTour.Mobile.Views.ShopDetailPage"
             x:DataType="viewmodels:ShopDetailViewModel"
             Title="{ext:Translate ShopDetail_Title}"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

	<!-- Converter giải quyết đường dẫn ảnh: ưu tiên cache cục bộ, fallback về URL API -->
	<ContentPage.Resources>
		<ext:ImageUrlConverter x:Key="ImageUrlConverter"/>
	</ContentPage.Resources>

	<Grid>
		<ScrollView>
		<VerticalStackLayout Spacing="0" Padding="0,0,0,24">

			<!-- Hero image + Back button -->
			<Grid>
				<Image Source="{Binding Shop.ImageUrl, Converter={StaticResource ImageUrlConverter}}" Aspect="AspectFill" HeightRequest="260"/>

				<!-- Gradient overlay at top for status bar readability -->
				<BoxView BackgroundColor="#40000000" HeightRequest="100" VerticalOptions="Start"/>

				<Button Text="{ext:Translate ShopDetail_Back}" Command="{Binding GoBackCommand}"
				        HorizontalOptions="Start" VerticalOptions="Start"
				        Margin="16,44,0,0"
				        BackgroundColor="#B0FFFFFF" TextColor="{StaticResource TextPrimary}"
				        CornerRadius="20" FontAttributes="Bold" FontSize="13"
				        HeightRequest="38" Padding="14,0"/>
			</Grid>

			<!-- Content area -->
			<VerticalStackLayout Padding="20,16" Spacing="10">

				<!-- Shop name -->
				<Label Text="{Binding Shop.Name}"
				       FontSize="24" FontAttributes="Bold"
				       TextColor="{StaticResource TextPrimary}"/>

				<!-- Address with icon -->
				<HorizontalStackLayout Spacing="6">
					<Label Text="📍" FontSize="14"/>
					<Label Text="{Binding Shop.Address}"
					       FontSize="14"
					       TextColor="{StaticResource TextSecondary}"/>
				</HorizontalStackLayout>

				<!-- Divider -->
				<BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="0,8"/>

				<!-- Description section -->
				<Label Text="{ext:Translate ShopDetail_Intro}"
				       FontSize="16" FontAttributes="Bold"
				       TextColor="{StaticResource TextPrimary}"
				       Margin="0,4,0,4"/>
				<Label Text="{Binding Shop.Description}"
				       LineHeight="1.4"
				       TextColor="{StaticResource TextSecondary}"
				       FontSize="14"/>



			</VerticalStackLayout>
		</VerticalStackLayout>
	</ScrollView>

	<!-- Global Audio Player Overlay -->
	<controls:FloatingAudioPlayer />

	</Grid>
</ContentPage>