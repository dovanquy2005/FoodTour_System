<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FoodTour.Mobile.ViewModels"
             xmlns:ext="clr-namespace:FoodTour.Mobile.Extensions"
             x:Class="FoodTour.Mobile.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<ext:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Margin="20, 20, 20, 40" Spacing="22">

			<!-- Page Header -->
			<Label Text="{ext:Translate Settings_Title}"
			       TextColor="{StaticResource TextPrimary}"
			       FontSize="28"
			       FontAttributes="Bold"
			       Margin="0, 8, 0, 4"/>


			<!-- ═══════ ỨNG DỤNG ═══════ -->
			<VerticalStackLayout Spacing="8">
				<Label Text="{ext:Translate Settings_App}"
				       TextColor="{StaticResource TextSecondary}"
				       FontSize="12"
				       FontAttributes="Bold"
				       Margin="4,0"
				       CharacterSpacing="1"/>

				<Border BackgroundColor="{StaticResource Surface}"
				        StrokeShape="RoundRectangle 16"
				        Stroke="{StaticResource CardBorder}"
				        StrokeThickness="1"
				        Padding="16,4"
				        Shadow="{Shadow Radius=6, Opacity=0.05, Offset='0,2'}">
					<Grid RowDefinitions="Auto, 1, Auto">

						<!-- Ngôn ngữ -->
						<Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="0,14">
							<Grid.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding ChangeLanguageCommand}"/>
							</Grid.GestureRecognizers>
							<Label Grid.Column="0" Text="🌐" FontSize="20" VerticalOptions="Center"/>
							<Label Grid.Column="1" Text="{ext:Translate Settings_Language}"
							       TextColor="{StaticResource TextPrimary}" FontSize="15"
							       VerticalOptions="Center" Margin="14,0"/>
							<HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
								<Label Text="{Binding SelectedLanguage}"
								       TextColor="{StaticResource TextSecondary}" FontSize="14"
								       VerticalOptions="Center"/>
								<Label Text="❯" TextColor="{StaticResource TextTertiary}"
								       FontSize="14" VerticalOptions="Center"/>
							</HorizontalStackLayout>
						</Grid>

						<BoxView Grid.Row="1" Color="{StaticResource Gray100}" HeightRequest="1" HorizontalOptions="Fill"/>

						<!-- Phiên bản -->
						<Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Padding="0,14">
							<Label Grid.Column="0" Text="📱" FontSize="20" VerticalOptions="Center"/>
							<Label Grid.Column="1" Text="{ext:Translate Settings_Version}"
							       TextColor="{StaticResource TextPrimary}" FontSize="15"
							       VerticalOptions="Center" Margin="14,0"/>
							<Label Grid.Column="2" Text="{Binding AppVersion}"
							       TextColor="{StaticResource TextSecondary}" FontSize="14"
							       VerticalOptions="Center"/>
						</Grid>
					</Grid>
				</Border>
			</VerticalStackLayout>

			<!-- ═══════ TÀI KHOẢN PREMIUM ═══════ -->
			<VerticalStackLayout Spacing="8">
				<Label Text="{ext:Translate Settings_AccountBenefits}"
				       TextColor="{StaticResource TextSecondary}"
				       FontSize="12"
				       FontAttributes="Bold"
				       Margin="4,0"
				       CharacterSpacing="1"/>

				<Border BackgroundColor="#FFFBF0"
				        StrokeShape="RoundRectangle 16"
				        Stroke="#FCE4A8"
				        StrokeThickness="1"
				        Padding="16,14"
				        Shadow="{Shadow Radius=6, Opacity=0.08, Offset='0,3', Brush='#F6B100'}">
					<Grid ColumnDefinitions="Auto, *">
						<Label Grid.Column="0" Text="💎" FontSize="28" VerticalOptions="Center" Margin="0,0,14,0"/>
						
						<VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
							<Label Text="{ext:Translate Settings_PremiumTitle}" FontAttributes="Bold" FontSize="16" TextColor="#B27D00" />
							
							<!-- Trạng thái chưa nâng cấp -->
							<VerticalStackLayout IsVisible="{Binding IsPremium, Converter={StaticResource InvertedBoolConverter}}" Spacing="6">
								<Label Text="{ext:Translate Settings_PremiumDesc}" 
								       FontSize="13" TextColor="#B5A899" MaxLines="2" LineBreakMode="TailTruncation" />
								<Button Text="{ext:Translate Settings_UpgradeBtn}" 
								        Command="{Binding UpgradePremiumCommand}"
								        BackgroundColor="#F6B100" TextColor="White" 
								        FontAttributes="Bold" CornerRadius="8" HeightRequest="36" Padding="16,0"
								        HorizontalOptions="Start" />
							</VerticalStackLayout>
							
							<!-- Trạng thái đã nâng cấp -->
							<HorizontalStackLayout IsVisible="{Binding IsPremium}" Spacing="6" VerticalOptions="Center" Margin="0,4,0,0">
								<Label Text="{ext:Translate Settings_Unlocked}" FontSize="14" TextColor="#22C55E" FontAttributes="Bold" />
								<Label Text="✓" FontSize="14" TextColor="#22C55E" FontAttributes="Bold" />
							</HorizontalStackLayout>
						</VerticalStackLayout>
					</Grid>
				</Border>
			</VerticalStackLayout>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>