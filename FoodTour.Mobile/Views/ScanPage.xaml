<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:FoodTour.Mobile.Extensions"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="FoodTour.Mobile.Views.ScanPage"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False">

    <!-- Bố cục toàn màn hình: Camera nền + Overlay đè lên trên -->
    <Grid>

        <!-- LỚP 1: Camera ZXing fill toàn màn hình -->
        <zxing:CameraBarcodeReaderView
            x:Name="barcodeReader"
            IsDetecting="True"
            IsTorchOn="False"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            BarcodesDetected="BarcodeReader_BarcodesDetected" />

        <!-- LỚP 2: Overlay tối mờ xung quanh khung ngắm -->
        <Grid BackgroundColor="#80000000"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="True" />

        <!-- LỚP 3: Nội dung UI chính đè lên trên -->
        <Grid RowDefinitions="Auto, *, Auto"
              Padding="20, 50, 20, 30">

            <!-- ═══════ HEADER ═══════ -->
            <Grid Grid.Row="0">
                <!-- Tiêu đề căn giữa -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="{ext:Translate Scan_Title}"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="{ext:Translate Scan_Subtitle}"
                           TextColor="#B0B0B0"
                           FontSize="13"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Nút Flash (đèn pin) — góc phải -->
                <Border x:Name="torchButton"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="0"
                        BackgroundColor="#44FFFFFF">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ToggleTorch_Tapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="torchIcon"
                           Text="🔦"
                           FontSize="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- ═══════ KHUNG NGẮM (Viewfinder) ═══════ -->
            <Grid Grid.Row="1"
                  VerticalOptions="Center"
                  HorizontalOptions="Center"
                  WidthRequest="260"
                  HeightRequest="260">

                <!-- Viền khung ngắm với bo góc -->
                <Border x:Name="viewfinderBorder"
                        StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="3"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"/>

                <!-- Đường quét laser di chuyển lên xuống -->
                <BoxView x:Name="scanLine"
                         HeightRequest="2"
                         WidthRequest="220"
                         Color="#E8672A"
                         Opacity="0.85"
                         HorizontalOptions="Center"
                         VerticalOptions="Start"
                         TranslationY="20"/>
            </Grid>

            <!-- ═══════ FOOTER ═══════ -->
            <Border Grid.Row="2"
                    BackgroundColor="#33FFFFFF"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    Padding="16,12">
                <Label Text="{ext:Translate Scan_FooterInstruction}"
                       TextColor="#D0D0D0"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.3"/>
            </Border>
        </Grid>

    </Grid>
</ContentPage>